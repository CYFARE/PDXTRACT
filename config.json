{
  "provider": "got_ocr20_native",
  "model": "stepfun-ai/GOT-OCR2_0",
  "strategy": "ocr_regex",
  "extractors": ["email"],
  "custom_regex": {},
  "prompt": "Transcribe all text visible in this image. Output only the raw text, no explanations.",
  "ollama_url": "http://127.0.0.1:11434",
  "llama_cpp_url": "http://127.0.0.1:8080",
  "input_folder": "./pdfs",
  "output_file": "output/extracted_data.json",
  "output_csv": null,
  "output_txt": null,
  "session_file": "aiocr_session.log",
  "temp_suffix": ".jsonl.tmp",
  "max_workers": 4,
  "page_dpi": 200,
  "use_embedded_text": true,
  "include_ocr_text": false,
  "got_ocr_device": "auto",
  "got_ocr_dtype": "auto",
  "retries": 2,
  "retry_delay_seconds": 3.0
}
